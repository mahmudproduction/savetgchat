# Скопируйте этот файл в .env и подставьте свои значения.
# .env не коммитится и не должен попадать в чат.

# Строка подключения Neon. Пароль остаётся только здесь.
# Проект всё равно включает sslmode=verify-full и проверяет сертификат.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=verify-full

# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=

# Юзербот Telethon. api_id и api_hash с https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+90...
# Пароль облачной двухфакторной защиты, если он включён. Иначе оставьте пустым.
TELEGRAM_PASSWORD=
# Подсказка, которую показывает Telegram. На вход не влияет.
TELEGRAM_PASSWORD_HINT=
